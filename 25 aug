#include <vector>
#include <unordered_set>

class Solution {
public:
    int missingMultiple(std::vector<int>& nums, int k) {
        std::unordered_set<int> num_set(nums.begin(), nums.end());
        int multiplier = 1;
        
        while (true) {
            int candidate = multiplier * k;
            if (num_set.find(candidate) == num_set.end()) {
                return candidate;
            }
            multiplier++;
        }
    }
};
