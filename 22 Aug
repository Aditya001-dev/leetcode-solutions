class Solution {
public:
    bool checkDivisibility(int n) {
        int original = n;
        int digit_sum = 0;
        int digit_product = 1;
        
        // Extract digits and compute sum and product
        while (n > 0) {
            int d = n % 10;
            digit_sum += d;
            digit_product *= d;
            n /= 10;
        }
        
        int total_sum = digit_sum + digit_product;
        
        // Return true if original n is divisible by the combined sum
        return original % total_sum == 0;
    }
};
