#include <vector>
#include <string>
#include <queue>
#include <tuple>

using namespace std;

class Solution {
public:
    int minMoves(vector<string>& classroom, int energy) {
        int m = classroom.size();
        int n = classroom[0].size();
        
        int startR = -1, startC = -1;
        vector<pair<int, int>> litters;
        
        for (int r = 0; r < m; ++r) {
            for (int c = 0; c < n; ++c) {
                if (classroom[r][c] == 'S') {
                    startR = r;
                    startC = c;
                } else if (classroom[r][c] == 'L') {
                    litters.push_back({r, c});
                }
            }
        }
        
        int numLitters = litters.size();
        int targetMask = (1 << numLitters) - 1;
        
        if (targetMask == 0) return 0;

        vector<vector<int>> litterIndex(m, vector<int>(n, -1));
        for (int i = 0; i < numLitters; ++i) {
            litterIndex[litters[i].first][litters[i].second] = i;
        }

        vector<vector<vector<int>>> max_energy(m, vector<vector<int>>(n, vector<int>(1 << numLitters, -1)));

        queue<tuple<int, int, int, int>> q;
        
        int initialMask = 0;
        if (litterIndex[startR][startC] != -1) {
            initialMask |= (1 << litterIndex[startR][startC]);
        }

        q.push({startR, startC, initialMask, energy});
        max_energy[startR][startC][initialMask] = energy;

        int moves = 0;
        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        while (!q.empty()) {
            int sz = q.size();
            while (sz--) {
                auto [r, c, mask, e] = q.front();
                q.pop();

                if (mask == targetMask) {
                    return moves;
                }

                if (e == 0) continue;

                for (int i = 0; i < 4; ++i) {
                    int nr = r + dr[i];
                    int nc = c + dc[i];

                    if (nr >= 0 && nr < m && nc >= 0 && nc < n && classroom[nr][nc] != 'X') {
                        int nextMask = mask;
                        
                        if (litterIndex[nr][nc] != -1) {
                            nextMask |= (1 << litterIndex[nr][nc]);
                        }

                        int nextEnergy = e - 1;

                        if (classroom[nr][nc] == 'R') {
                            nextEnergy = energy;
                        }

                        if (nextEnergy > max_energy[nr][nc][nextMask]) {
                            max_energy[nr][nc][nextMask] = nextEnergy;
                            q.push({nr, nc, nextMask, nextEnergy});
                        }
                    }
                }
            }
            moves++;
        }

        return -1;
    }
};
