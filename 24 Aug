#include <vector>
#include <algorithm>

class Solution {
public:
    long long stoneGameVIII(std::vector<int>& stones) {
        int n = stones.size();
        
        // Compute prefix sums (1-indexed)
        std::vector<long long> P(n + 1, 0);
        for (int i = 0; i < n; ++i) {
            P[i + 1] = P[i] + stones[i];
        }

        // dp[i] stores the max score difference from state i
        std::vector<long long> dp(n + 1, 0);
        
        // Base case: dp[n] = 0 (game ends when only 1 stone is left at i = n)
        // Maintain the suffix maximum of (P[k] - dp[k]) for k > i
        long long max_val = P[n] - dp[n];

        for (int i = n - 1; i >= 1; --i) {
            dp[i] = max_val;
            max_val = std::max(max_val, P[i] - dp[i]);
        }

        return dp[1];
    }
};
